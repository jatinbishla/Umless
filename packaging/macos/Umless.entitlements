<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Used only with a Developer ID (hardened runtime, for notarisation): the runtime blocks
     the microphone unless the app declares it. Accessibility and Input Monitoring need no
     entitlement; the user grants them in System Settings. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.device.audio-input</key><true/>
</dict>
</plist>
